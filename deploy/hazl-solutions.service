# systemd unit for the HAZL Solutions site (including the Vibe Studio).
#
# Secrets are NOT in this file and not in the environment of the deploy user.
# The box holds two read-only Doppler service tokens under /etc/hazl/ and
# resolves credentials itself at start, so a copy of this unit leaks nothing.
#
# Install: /etc/systemd/system/hazl-solutions.service
[Unit]
Description=HAZL Solutions (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hazl
Group=hazl
WorkingDirectory=/srv/hazl-solutions/current

# Two nested doppler run invocations, matching scripts/run-with-doppler.sh.
# The INNER config wins on a key collision, which is why `npm run vibe:check`
# asserts the resolved DATABASE_URL host.
#
# -p/-c ARE REQUIRED on both, even though each token is already scoped to one
# project. `doppler run` injects DOPPLER_PROJECT/DOPPLER_CONFIG/DOPPLER_ENVIRONMENT
# into the environment it hands to the child, so the inner invocation inherits
# DOPPLER_PROJECT=hazl-general and tries to fetch that project with the dr-keys
# token:
#     Doppler Error: This token does not have access to requested project 'hazl-general'
# and, with Restart=always, the unit crash-loops. Explicit flags override the
# inherited variables. run-with-doppler.sh already passes -p/-c, which is why the
# local path always worked while this one could never have.
EnvironmentFile=/etc/hazl/doppler.env
# PORT comes from /etc/hazl/doppler.env. The host already runs other Next apps
# on 3000 and 3001 (fruttagala, smswebpages), so this MUST NOT default to 3000 --
# a collision would fail to bind and, worse, could be mistaken for the wrong app
# responding. Verify with `ss -tln` before changing it.
ExecStart=/usr/bin/doppler run --token "${DOPPLER_TOKEN_GENERAL}" -p hazl-general -c prd -- \
          /usr/bin/doppler run --token "${DOPPLER_TOKEN_LLM}" -p dr-keys -c prd_llm_opus4-8 -- \
          /usr/bin/node node_modules/.bin/next start --port ${PORT}

Restart=always
RestartSec=3
# Generation turns run 60-100s; give in-flight requests time to finish.
TimeoutStopSec=120
KillSignal=SIGTERM

# This is a SHARED t3.micro (1 GB) already running four production sites and
# touching swap. A memory ceiling means a runaway here degrades this service
# rather than OOM-killing a neighbour. MemoryHigh throttles first; MemoryMax is
# the hard stop. Raise both if the box is ever resized.
MemoryHigh=220M
MemoryMax=320M
# Two vCPUs shared with everything else; generation is I/O-bound on the LLM
# gateway, so this only bites during a scrypt burst or an HTML parse storm.
CPUWeight=50

# The Doppler CLI creates a config directory under $HOME on EVERY invocation,
# even when the token is passed on the command line. ProtectHome=true below
# makes /home unreachable inside this unit's namespace, so the default
# HOME=/home/hazl fails with
#     Doppler Error: mkdir /home/hazl/.doppler: permission denied
# and, with Restart=always, the unit crash-loops instead of starting. The
# on-disk permissions of /home/hazl are irrelevant -- it is the namespace that
# hides it, which is why this reproduces only under systemd and not under a
# plain `sudo -u hazl`.
#
# RuntimeDirectory gives /run/hazl-solutions, created on start owned by User=
# and removed on stop. /run is untouched by ProtectHome and is made writable
# despite ProtectSystem=strict, so it needs no ReadWritePaths entry.
RuntimeDirectory=hazl-solutions
Environment=HOME=/run/hazl-solutions

# Hardening. ReadWritePaths is the storage volume: generated documents are the
# source of truth and must survive, so the rest of the filesystem is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hazl-vibe /srv/hazl-solutions
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hazl-solutions

[Install]
WantedBy=multi-user.target
