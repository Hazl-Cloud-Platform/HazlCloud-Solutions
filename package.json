{
  "name": "hazl-solutions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vibe": "./scripts/run-with-doppler.sh next dev",
    "start:vibe": "./scripts/run-with-doppler.sh next start",
    "vibe:migrate": "doppler run -p hazl-general -c prd -- npx tsx scripts/vibe-migrate.ts",
    "vibe:check": "doppler run -p hazl-general -c prd -- npx tsx scripts/vibe-check.ts",
    "vibe:hash": "npx tsx scripts/vibe-hash-password.ts",
    "vibe:probe": "doppler run -p dr-keys -c prd_llm_opus4-8 -- npx tsx scripts/vibe-probe-llm.ts",
    "vibe:smoke": "./scripts/run-with-doppler.sh npx tsx scripts/vibe-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@marsidev/react-turnstile": "^1.1.0",
    "@portabletext/react": "^3.2.4",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^3.99.0",
    "lucide-react": "^0.460.0",
    "next": "14.2.5",
    "next-sanity": "^9.12.3",
    "parse5": "^7.2.1",
    "pg": "^8.13.1",
    "react": "^18",
    "react-dom": "^18",
    "sanity": "^3.99.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
