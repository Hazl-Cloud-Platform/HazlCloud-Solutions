# Public site URL (used for canonical, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://hazlsolutions.com

# Sanity (get these from https://sanity.io/manage after creating a project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional read token for previews/private datasets (not required for published content)
SANITY_API_READ_TOKEN=

# Shared secret for the /api/revalidate webhook
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# ─── Vibe Studio (the /startup/studio UI-mockup builder) ─────────────────────
# All of these come from Doppler in real environments; see README "Vibe Studio".
#
#   doppler run -p hazl-general -c prd -- \
#     doppler run -p dr-keys -c prd_llm_opus4-8 -- npm run dev
#
# The studio needs a persistent filesystem and generations run 60-100s, so it is
# OFF unless VIBE_ENABLED=1. Leave it unset on any serverless deployment.
VIBE_ENABLED=
NEXT_PUBLIC_VIBE_ENABLED=

# Where generated documents live. Disk is the source of truth; Postgres only
# stores the pointer. Must be writable and on a volume with monitored free space.
VIBE_STORAGE_DIR=

# Set to 1 ONLY behind a proxy we control that rewrites the forwarded headers.
# Anywhere else these headers are attacker-supplied and every per-IP cap is moot.
VIBE_TRUST_PROXY=

# openssl rand -hex 32, each of them different
VIBE_SESSION_SECRET=
VIBE_ADMIN_SESSION_SECRET=
VIBE_IP_SALT=

VIBE_ADMIN_EMAILS=admin@example.com
# npm run vibe:hash  (never store the plaintext anywhere)
VIBE_ADMIN_PASSWORD_HASH=

# docs/turnstile-setup.md. Local dev works without them (verification is skipped
# outside production); use Cloudflare's test keys to exercise the real path.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Anthropic gateway — Doppler dr-keys / prd_llm_opus4-8.
# ANTHROPIC_MODEL is a deployment name: pass it through verbatim.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=

# Supabase Postgres — Doppler hazl-general / prd.
# DATABASE_URL is the transaction pooler (6543); MIGRATION_DATABASE_URL is the
# direct connection (5432), because PgBouncer cannot run DDL transactions.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Optional tuning
VIBE_LLM_EFFORT=low
VIBE_ALLOW_IMAGE_CDN=1
LLM_MAX_TOKENS=
